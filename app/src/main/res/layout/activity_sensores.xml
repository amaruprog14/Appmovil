<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2EFEF"
    android:fillViewport="true"
    tools:context=".sensores">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/imageView13"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_mejorado" />

        <TextView
            android:id="@+id/textView13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Fecha: --"
            android:textColor="#000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView13" />

        <!-- Mensaje de error de la API de sensores (oculto mientras todo funciona) -->
        <TextView
            android:id="@+id/tvEstadoApi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:minLines="2"
            android:text=""
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView13" />

        <ImageView
            android:id="@+id/imageView20"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginStart="48dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Temperatura"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvEstadoApi"
            app:srcCompat="@drawable/hot" />

        <TextView
            android:id="@+id/textView14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:text="Temperatura"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintStart_toEndOf="@+id/imageView20"
            app:layout_constraintTop_toTopOf="@+id/imageView20" />

        <TextView
            android:id="@+id/textView15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="--"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/textView14"
            app:layout_constraintTop_toBottomOf="@+id/textView14" />

        <ImageView
            android:id="@+id/imageView23"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginStart="48dp"
            android:layout_marginTop="20dp"
            android:contentDescription="Humedad"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView20"
            app:srcCompat="@drawable/gotas" />

        <TextView
            android:id="@+id/textView16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:text="Humedad"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintStart_toEndOf="@+id/imageView23"
            app:layout_constraintTop_toTopOf="@+id/imageView23" />

        <TextView
            android:id="@+id/textView17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="--"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/textView16"
            app:layout_constraintTop_toBottomOf="@+id/textView16" />

        <!-- Ampolleta: solo cambia la imagen -->
        <ImageView
            android:id="@+id/imgAmpolleta"
            android:layout_width="120dp"
            android:layout_height="110dp"
            android:layout_marginTop="28dp"
            android:contentDescription="Ampolleta"
            app:layout_constraintEnd_toStartOf="@+id/imgLinterna"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView23"
            app:srcCompat="@drawable/apagada" />

        <!-- Linterna: enciende y apaga la linterna real del teléfono -->
        <ImageView
            android:id="@+id/imgLinterna"
            android:layout_width="120dp"
            android:layout_height="110dp"
            android:contentDescription="Linterna"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgAmpolleta"
            app:layout_constraintTop_toTopOf="@+id/imgAmpolleta"
            app:srcCompat="@drawable/linterna_apagada" />

        <TextView
            android:id="@+id/tvLblAmpolleta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ampolleta"
            android:textColor="#000000"
            app:layout_constraintEnd_toEndOf="@+id/imgAmpolleta"
            app:layout_constraintStart_toStartOf="@+id/imgAmpolleta"
            app:layout_constraintTop_toBottomOf="@+id/imgAmpolleta" />

        <TextView
            android:id="@+id/tvLblLinterna"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Linterna"
            android:textColor="#000000"
            app:layout_constraintEnd_toEndOf="@+id/imgLinterna"
            app:layout_constraintStart_toStartOf="@+id/imgLinterna"
            app:layout_constraintTop_toBottomOf="@+id/imgLinterna" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>