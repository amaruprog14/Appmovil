<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2EFEF"
    tools:context=".principal">

    <ImageView
        android:id="@+id/iconSensores"
        android:layout_width="79dp"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.093"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iconCrud"
        app:srcCompat="@drawable/sensores" />

    <TextView
        android:id="@+id/textSensores"
        android:layout_width="129dp"
        android:layout_height="36dp"
        android:layout_marginTop="64dp"
        android:text="Sensores"
        android:textColor="#000000"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.104"
        app:layout_constraintStart_toEndOf="@+id/iconSensores"
        app:layout_constraintTop_toBottomOf="@+id/textCrud" />

    <ImageView
        android:id="@+id/iconInfo"
        android:layout_width="79dp"
        android:layout_height="72dp"
        android:layout_marginTop="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.093"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iconSensores"
        app:srcCompat="@drawable/crud" />

    <TextView
        android:id="@+id/textCrud"
        android:layout_width="206dp"
        android:layout_height="39dp"
        android:layout_marginTop="56dp"
        android:text="Crud de Usuarios"
        android:textColor="#000000"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.189"
        app:layout_constraintStart_toEndOf="@+id/iconCrud"
        app:layout_constraintTop_toBottomOf="@+id/imageView4" />

    <ImageView
        android:id="@+id/iconCrud"
        android:layout_width="79dp"
        android:layout_height="72dp"
        android:layout_marginTop="196dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.093"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/crud" />

    <TextView
        android:id="@+id/textInfo"
        android:layout_width="191dp"
        android:layout_height="41dp"
        android:layout_marginTop="64dp"
        android:text="Desarrolladores"
        android:textColor="#000000"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.163"
        app:layout_constraintStart_toEndOf="@+id/iconInfo"
        app:layout_constraintTop_toBottomOf="@+id/textSensores" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="140dp"
        android:layout_height="142dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_mejorado" />
</androidx.constraintlayout.widget.ConstraintLayout>